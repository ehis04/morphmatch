# Accounts and saved comparisons (optional).
# Local: install Supabase CLI + Docker, then run npm run db:setup.
# This writes the local URL and public anon key into .env.local automatically.
# Hosted: copy your project URL and anon/publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public key. Never use an sb_secret or service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key (used only when PUBLISHABLE_KEY is empty).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enable only after configuring the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Required for production: your real public HTTPS origin, with no path or query.
# Used for sitemap, social metadata and account callbacks; omit locally.
# npm run check:production rejects placeholders and local Supabase settings.
# Vercel previews can use VERCEL_URL automatically when SITE_URL is unset.
SITE_URL=
